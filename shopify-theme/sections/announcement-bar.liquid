<div class="w-annc">
  <div class="w-annc__row">
    {% for block in section.blocks %}
      <span class="w-annc__item">{% render 'icon-check' %} {{ block.settings.text }}</span>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "100 dagen bedenktijd" }
    ]}
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "100 dagen bedenktijd" } },
      { "type": "item", "settings": { "text": "Gratis bezorging" } },
      { "type": "item", "settings": { "text": "Tot 5 jaar garantie" } }
    ]
  }
}
{% endschema %}
